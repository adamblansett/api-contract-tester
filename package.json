{
  "name": "api-contract-tester",
  "version": "0.1.0",
  "description": "Production-minded TypeScript CLI that validates HTTP APIs against explicit contracts and detects integration regressions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "api-contract-tester": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build"
  },
  "keywords": [
    "api",
    "contract-testing",
    "integration-testing",
    "http",
    "json-schema",
    "regression-testing",
    "cli",
    "typescript"
  ],
  "author": "Adam Blansett <https://adamblansett.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamblansett/api-contract-tester.git"
  },
  "bugs": {
    "url": "https://github.com/adamblansett/api-contract-tester/issues"
  },
  "homepage": "https://github.com/adamblansett/api-contract-tester#readme",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^5.0.3"
  }
}
